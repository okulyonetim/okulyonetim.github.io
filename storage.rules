rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function girisYapmis() {
      return request.auth != null;
    }

    function adminMi() {
      return girisYapmis()
        && firestore.get(/databases/(default)/documents/oy_kullanicilar/$(request.auth.uid)).data.admin == true;
    }

    function konusmaKatilimcisiMi(konusmaId) {
      return girisYapmis()
        && request.auth.uid in firestore.get(/databases/(default)/documents/oy_konusmalar/$(konusmaId)).data.katilimciUidler;
    }

    function mesajDosyasiTuruGecerliMi() {
      return request.resource != null
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('application/pdf|application/msword|application/vnd.openxmlformats-officedocument.wordprocessingml.document|application/vnd.ms-excel|application/vnd.openxmlformats-officedocument.spreadsheetml.sheet|image/jpeg|image/png|image/gif|image/webp');
    }

    match /mesajDosyalari/{konusmaId}/{dosyaYolu=**} {
      allow read: if adminMi() || konusmaKatilimcisiMi(konusmaId);
      allow write: if (adminMi() || konusmaKatilimcisiMi(konusmaId))
        && (request.resource == null || mesajDosyasiTuruGecerliMi());
    }

    // Yeni doküman yolu: dokumanlar/{sahipUid}/{dosya...}
    // Kişisel dosya yalnız sahibi+admin; herkese açık dosya tüm girişli
    // kullanıcılar tarafından okunabilir. Normal kullanıcı görünürlüğü
    // Storage metadata üzerinden sonradan yükseltemez.
    match /dokumanlar/{sahipUid}/{dosyaYolu=**} {
      allow read: if girisYapmis() && (
        adminMi()
        || request.auth.uid == sahipUid
        || resource.metadata.gorunurluk == 'herkes'
      );

      allow create: if girisYapmis()
        && request.resource.metadata.olusturanUid == sahipUid
        && (
          (request.auth.uid == sahipUid && request.resource.metadata.gorunurluk == 'kisisel')
          || (adminMi() && request.resource.metadata.gorunurluk in ['kisisel','herkes'])
        );

      allow update: if adminMi() || (
        girisYapmis()
        && request.auth.uid == sahipUid
        && resource.metadata.olusturanUid == sahipUid
        && request.resource.metadata.olusturanUid == sahipUid
        && request.resource.metadata.gorunurluk == resource.metadata.gorunurluk
      );

      allow delete: if adminMi() || (girisYapmis() && request.auth.uid == sahipUid);
    }

    // Eski sürümlerdeki dokumanlar/{dosya} yolu geriye dönük uyumluluk için
    // korunur. Yeni kod bu yola artık dosya yüklemez.
    match /dokumanlar/{legacyDosya} {
      allow read, write: if girisYapmis();
    }

    match /{ustYol}/{kalan=**} {
      allow read, write: if girisYapmis()
        && ustYol != 'mesajDosyalari'
        && ustYol != 'dokumanlar';
    }
  }
}
