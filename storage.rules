rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function girisYapmis() { return request.auth != null; }

    function kullaniciBelgesiVarMi() {
      return girisYapmis()
        && firestore.exists(/databases/(default)/documents/oy_kullanicilar/$(request.auth.uid));
    }

    function kullaniciBelgesi() {
      return firestore.get(/databases/(default)/documents/oy_kullanicilar/$(request.auth.uid));
    }

    function adminMi() {
      return kullaniciBelgesiVarMi()
        && 'admin' in kullaniciBelgesi().data
        && kullaniciBelgesi().data.admin == true;
    }

    function rolBelgemVarMi() {
      return kullaniciBelgesiVarMi()
        && 'rolId' in kullaniciBelgesi().data
        && kullaniciBelgesi().data.rolId != null
        && firestore.exists(/databases/(default)/documents/oy_roller/$(kullaniciBelgesi().data.rolId));
    }

    function moduluDuzenleyebilir(modul) {
      return adminMi() || (rolBelgemVarMi()
        && 'yetkiler' in firestore.get(/databases/(default)/documents/oy_roller/$(kullaniciBelgesi().data.rolId)).data
        && modul in firestore.get(/databases/(default)/documents/oy_roller/$(kullaniciBelgesi().data.rolId)).data.yetkiler
        && firestore.get(/databases/(default)/documents/oy_roller/$(kullaniciBelgesi().data.rolId)).data.yetkiler[modul] == 'duzenle');
    }

    function konusmaKatilimcisiMi(konusmaId) {
      return girisYapmis()
        && firestore.exists(/databases/(default)/documents/oy_konusmalar/$(konusmaId))
        && request.auth.uid in firestore.get(/databases/(default)/documents/oy_konusmalar/$(konusmaId)).data.katilimciUidler;
    }

    function mesajDosyasiTuruGecerliMi() {
      return request.resource != null
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('application/pdf|application/msword|application/vnd.openxmlformats-officedocument.wordprocessingml.document|application/vnd.ms-excel|application/vnd.openxmlformats-officedocument.spreadsheetml.sheet|image/jpeg|image/png|image/gif|image/webp');
    }

    match /mesajDosyalari/{konusmaId}/{dosyaYolu=**} {
      allow read: if adminMi() || konusmaKatilimcisiMi(konusmaId);
      allow write: if (adminMi() || konusmaKatilimcisiMi(konusmaId))
        && (request.resource == null || mesajDosyasiTuruGecerliMi());
    }

    match /dokumanlar/{sahipUid}/{dosyaYolu=**} {
      allow read: if girisYapmis() && (adminMi() || request.auth.uid == sahipUid || resource.metadata.gorunurluk == 'herkes');
      allow create: if girisYapmis()
        && request.resource.metadata.olusturanUid == sahipUid
        && ((request.auth.uid == sahipUid && request.resource.metadata.gorunurluk == 'kisisel')
          || (adminMi() && request.resource.metadata.gorunurluk in ['kisisel','herkes']));
      allow update: if adminMi() || (girisYapmis()
        && request.auth.uid == sahipUid
        && resource.metadata.olusturanUid == sahipUid
        && request.resource.metadata.olusturanUid == sahipUid
        && request.resource.metadata.gorunurluk == resource.metadata.gorunurluk);
      allow delete: if adminMi() || (girisYapmis() && request.auth.uid == sahipUid);
    }

    match /dokumanlar/{legacyDosya} {
      allow read, write: if girisYapmis();
    }

    match /duyurular/{dosyaYolu=**} {
      allow read: if girisYapmis();
      allow write: if moduluDuzenleyebilir('duyurular');
    }

    match /{ustYol}/{kalan=**} {
      allow read, write: if girisYapmis()
        && ustYol != 'mesajDosyalari'
        && ustYol != 'dokumanlar'
        && ustYol != 'duyurular';
    }
  }
}
