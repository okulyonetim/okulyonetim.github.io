<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/modern_event_root"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="4dp">
    <LinearLayout android:id="@+id/modern_event_card" android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:paddingLeft="8dp" android:paddingRight="8dp" android:paddingTop="6dp" android:paddingBottom="5dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <TextView android:id="@+id/modern_event_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="📚 ETKİNLİKLER" android:textSize="12sp" android:textStyle="bold" android:maxLines="1"/>
            <TextView android:id="@+id/modern_event_more" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Bugün" android:textSize="8sp"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/ev1" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical"><TextView android:id="@+id/ev1_time" android:layout_width="42dp" android:layout_height="wrap_content" android:textSize="9sp" android:textStyle="bold"/><TextView android:id="@+id/ev1_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="1" android:ellipsize="end" android:textSize="10sp" android:textStyle="bold"/></LinearLayout>
        <LinearLayout android:id="@+id/ev2" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical"><TextView android:id="@+id/ev2_time" android:layout_width="42dp" android:layout_height="wrap_content" android:textSize="9sp" android:textStyle="bold"/><TextView android:id="@+id/ev2_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="1" android:ellipsize="end" android:textSize="10sp"/></LinearLayout>
        <LinearLayout android:id="@+id/ev3" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical"><TextView android:id="@+id/ev3_time" android:layout_width="42dp" android:layout_height="wrap_content" android:textSize="9sp" android:textStyle="bold"/><TextView android:id="@+id/ev3_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="1" android:ellipsize="end" android:textSize="10sp"/></LinearLayout>
        <LinearLayout android:id="@+id/ev4" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical"><TextView android:id="@+id/ev4_time" android:layout_width="42dp" android:layout_height="wrap_content" android:textSize="9sp" android:textStyle="bold"/><TextView android:id="@+id/ev4_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="1" android:ellipsize="end" android:textSize="10sp"/></LinearLayout>
    </LinearLayout>
</LinearLayout>