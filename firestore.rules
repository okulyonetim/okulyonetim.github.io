// Bu kuralları Firebase Console > Firestore Database > Kurallar (Rules)
// sekmesine yapıştırıp "Yayınla" (Publish) demeniz gerekir — bu dosya
// otomatik olarak Firebase'e yüklenmez.
//
// GÜNCELLEME: Uygulama kullanıcı adı/şifre ile giriş yaptırıyor (bkz. js/auth.js).
// Bu dosyada mevcut kullanıcı/rol davranışı KORUNUR. Güvenlik açısından kritik
// koleksiyonlar genel authenticated-user kuralından çıkarılır ve aşağıdaki özel
// kurallarıyla korunur.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function girisYapmis() { return request.auth != null; }

    function kendiBelgemVarMi() {
      return girisYapmis()
        && exists(/databases/$(database)/documents/oy_kullanicilar/$(request.auth.uid));
    }

    function kullaniciBelgesi() {
      return get(/databases/$(database)/documents/oy_kullanicilar/$(request.auth.uid));
    }

    function adminMi() {
      return girisYapmis() && kendiBelgemVarMi() && kullaniciBelgesi().data.admin == true;
    }

    function rolBelgemVarMi() {
      return kendiBelgemVarMi()
        && kullaniciBelgesi().data.rolId != null
        && exists(/databases/$(database)/documents/oy_roller/$(kullaniciBelgesi().data.rolId));
    }

    function moduluDuzenleyebilir(modul) {
      return adminMi() || (rolBelgemVarMi()
        && modul in get(/databases/$(database)/documents/oy_roller/$(kullaniciBelgesi().data.rolId)).data.yetkiler
        && get(/databases/$(database)/documents/oy_roller/$(kullaniciBelgesi().data.rolId)).data.yetkiler[modul] in ['duzenle', 'edit']);
    }

    function moduluGorebilir(modul) {
      return adminMi() || (rolBelgemVarMi()
        && modul in get(/databases/$(database)/documents/oy_roller/$(kullaniciBelgesi().data.rolId)).data.yetkiler
        && get(/databases/$(database)/documents/oy_roller/$(kullaniciBelgesi().data.rolId)).data.yetkiler[modul] in ['goruntule', 'duzenle', 'preview', 'read', 'edit']);
    }

    function kendiOgretmenIdsi() {
      return kendiBelgemVarMi() ? kullaniciBelgesi().data.bagliOgretmenId : null;
    }

    function kendiSinifiMi(sinifId) {
      return girisYapmis()
        && kendiOgretmenIdsi() != null
        && exists(/databases/$(database)/documents/oy_siniflar/$(sinifId))
        && get(/databases/$(database)/documents/oy_siniflar/$(sinifId)).data.sinifOgretmeniId == kendiOgretmenIdsi();
    }

    function kulupDanismaniMi(kulupId) {
      return girisYapmis()
        && kulupId != null
        && kulupId != ''
        && kendiOgretmenIdsi() != null
        && exists(/databases/$(database)/documents/oy_sosyalKulupler/$(kulupId))
        && kendiOgretmenIdsi() in get(/databases/$(database)/documents/oy_sosyalKulupler/$(kulupId)).data.ogretmenIdler;
    }

    function konusmaKatilimcisiMi(konusmaId) {
      return girisYapmis()
        && exists(/databases/$(database)/documents/oy_konusmalar/$(konusmaId))
        && request.auth.uid in get(/databases/$(database)/documents/oy_konusmalar/$(konusmaId)).data.katilimciUidler;
    }

    // Koruk Asistan'ın tüm Firestore koleksiyonları oy_ ad alanındadır.
    // Bu ad alanında varsayılan izin YOKTUR; yalnız aşağıda açıkça tanımlanan
    // aktif koleksiyonlar erişilebilir. Böylece emekli/unutulmuş koleksiyonlar
    // genel authenticated catch-all üzerinden yanlışlıkla yeniden açılamaz.
    match /{koleksiyon}/{belgeId} {
      allow read, write: if girisYapmis() && !koleksiyon.matches('^oy_.*');
    }

    match /oy_kullanicilar/{uid} {
      allow read: if girisYapmis();
      allow write: if adminMi();
    }

    match /oy_roller/{id} {
      allow read: if girisYapmis();
      allow write: if adminMi();
    }

    match /oy_navDuzeni/{id} {
      allow read: if girisYapmis();
      allow write: if adminMi();
    }

    match /oy_kullaniciIstatistikleri/{uid} {
      allow read: if adminMi() || (girisYapmis() && request.auth.uid == uid);
      allow write: if girisYapmis() && request.auth.uid == uid;
    }

    match /oy_kullaniciTercihleri/{uid} {
      allow read, create, update, delete: if adminMi() || (girisYapmis() && request.auth.uid == uid);
    }

    match /oy_cihazTokenleri/{id} {
      allow read: if adminMi() || (girisYapmis() && resource.data.uid == request.auth.uid);
      allow create: if girisYapmis() && request.resource.data.uid == request.auth.uid;
      allow update: if adminMi() || (girisYapmis()
        && request.resource.data.uid == request.auth.uid
        && (resource.data.uid == request.auth.uid || !('uid' in resource.data)));
      allow delete: if adminMi() || (girisYapmis() && resource.data.uid == request.auth.uid);
    }

    match /oy_ogretmenListeSablon/{id} {
      allow read: if adminMi() || (girisYapmis() && kendiOgretmenIdsi() != null && resource.data.ogretmenId == kendiOgretmenIdsi());
      allow create: if adminMi() || (girisYapmis() && kendiOgretmenIdsi() != null && request.resource.data.ogretmenId == kendiOgretmenIdsi());
      allow update: if adminMi() || (girisYapmis() && kendiOgretmenIdsi() != null
        && resource.data.ogretmenId == kendiOgretmenIdsi()
        && request.resource.data.ogretmenId == kendiOgretmenIdsi());
      allow delete: if adminMi() || (girisYapmis() && kendiOgretmenIdsi() != null && resource.data.ogretmenId == kendiOgretmenIdsi());
    }

    match /oy_ogretmenListeKayit/{id} {
      allow read: if adminMi() || (girisYapmis() && kendiOgretmenIdsi() != null && resource.data.ogretmenId == kendiOgretmenIdsi());
      allow create: if adminMi() || (girisYapmis() && kendiOgretmenIdsi() != null && request.resource.data.ogretmenId == kendiOgretmenIdsi());
      allow update: if adminMi() || (girisYapmis() && kendiOgretmenIdsi() != null
        && resource.data.ogretmenId == kendiOgretmenIdsi()
        && request.resource.data.ogretmenId == kendiOgretmenIdsi());
      allow delete: if adminMi() || (girisYapmis() && kendiOgretmenIdsi() != null && resource.data.ogretmenId == kendiOgretmenIdsi());
    }

    match /oy_yoklama/{belgeId} {
      allow read: if girisYapmis();
      allow create: if moduluGorebilir('yoklama')
        && belgeId == request.resource.data.sinifId + '_' + request.resource.data.tarih
        && request.resource.data.keys().hasOnly(['sinifId', 'tarih']);
      allow update: if adminMi() || (moduluGorebilir('yoklama')
        && request.resource.data.sinifId == resource.data.sinifId
        && request.resource.data.tarih == resource.data.tarih
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sinifId','tarih','kayitlar','girenUid','girenAdi','guncellenmeTarihi'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['girenUid']) || request.resource.data.girenUid == request.auth.uid));
      allow delete: if adminMi();
    }

    match /oy_servisler/{servisId} {
      allow read: if girisYapmis();
      allow create, update, delete: if moduluDuzenleyebilir('tasima');
    }

    match /oy_servisOturma/{servisId} {
      allow read: if girisYapmis();
      allow create, update, delete: if moduluDuzenleyebilir('tasima');
    }

    match /oy_ogrenciler/{ogrenciId} {
      allow read: if girisYapmis();
      allow create, update, delete: if moduluDuzenleyebilir('ogrenciler') || moduluDuzenleyebilir('siniflar');
    }

    match /oy_siniflar/{id} {
      allow read: if girisYapmis();
      allow create, update, delete: if moduluDuzenleyebilir('siniflar');
    }

    match /oy_sinifOturma/{sinifId} {
      allow read: if girisYapmis();
      allow create, update, delete: if moduluDuzenleyebilir('siniflar') || kendiSinifiMi(sinifId);
    }

    match /oy_veliler/{id} {
      allow read: if girisYapmis();
      allow create, delete: if moduluDuzenleyebilir('siniflar') || moduluDuzenleyebilir('ogrenciler');
      allow update: if moduluDuzenleyebilir('siniflar') || moduluDuzenleyebilir('ogrenciler')
        || (girisYapmis()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['kulupId', 'kulupAdi'])
          && (kulupDanismaniMi(resource.data.kulupId) || kulupDanismaniMi(request.resource.data.kulupId)));
    }

    match /oy_personel/{id} {
      allow read: if girisYapmis();
      allow create, update, delete: if moduluDuzenleyebilir('personel');
    }

    match /oy_personelIzinler/{id} {
      allow read: if girisYapmis();
      allow create, update, delete: if moduluDuzenleyebilir('personel');
    }

    match /oy_devamsizlikCizelgesi/{id} {
      allow read: if girisYapmis();
      allow create, update, delete: if moduluDuzenleyebilir('personel');
    }

    match /oy_dilekceler/{id} {
      allow read: if girisYapmis();
      allow create, update, delete: if moduluDuzenleyebilir('personel');
    }

    match /oy_ogretmenler/{id} {
      allow read: if girisYapmis();
      allow create: if moduluDuzenleyebilir('ogretmenler')
        || (moduluDuzenleyebilir('nobet')
          && request.resource.data.keys().hasOnly(['ad','soyad','unvan','brans','telefon','eposta','sorumluSinif','eklenmeTarihi']));
      allow update, delete: if moduluDuzenleyebilir('ogretmenler');
    }

    match /oy_ogretmenIzinleri/{id} {
      allow read: if girisYapmis();
      allow create, update, delete: if moduluDuzenleyebilir('ogretmenler');
    }

    match /oy_haritaFavoriler/{id} {
      allow read: if adminMi() || (girisYapmis() && resource.data.olusturanUid == request.auth.uid);
      allow create: if moduluDuzenleyebilir('harita')
        && request.resource.data.olusturanUid == request.auth.uid;
      allow update: if adminMi() || (moduluDuzenleyebilir('harita')
        && resource.data.olusturanUid == request.auth.uid
        && request.resource.data.olusturanUid == request.auth.uid);
      allow delete: if adminMi() || (moduluDuzenleyebilir('harita')
        && resource.data.olusturanUid == request.auth.uid);
    }

    match /oy_nobetYerleri/{id} {
      allow read: if girisYapmis();
      allow create, update, delete: if moduluDuzenleyebilir('nobet');
    }

    match /oy_nobetAtamalari/{id} {
      allow read: if girisYapmis();
      allow create, delete: if moduluDuzenleyebilir('nobet');
      allow update: if moduluDuzenleyebilir('nobet') || (girisYapmis()
        && kendiOgretmenIdsi() != null
        && kendiOgretmenIdsi() == resource.data.ogretmenId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['defterDolduruldu'])
        && request.resource.data.defterDolduruldu is bool);
    }

    match /oy_nobetciAmirleri/{id} {
      allow read: if girisYapmis();
      allow create, update, delete: if moduluDuzenleyebilir('nobet');
    }

    match /oy_resmiTatiller/{id} {
      allow read: if girisYapmis();
      allow create, update, delete: if moduluDuzenleyebilir('nobet');
    }

    match /oy_nobetRotasyon/{id} {
      allow read: if girisYapmis();
      allow create, update, delete: if moduluDuzenleyebilir('nobet');
    }

    match /oy_periyodikIsler/{id} {
      allow read: if girisYapmis();
      allow create, update, delete: if moduluDuzenleyebilir('periyodikIsler');
    }

    match /oy_periyodikSablon/{id} {
      allow read: if girisYapmis();
      allow create, update, delete: if moduluDuzenleyebilir('periyodikIsler');
    }

    match /oy_sinavlar/{id} {
      allow read: if girisYapmis();
      allow create: if adminMi() || (moduluDuzenleyebilir('sinavIslemleri')
        && request.resource.data.sahipUid == request.auth.uid);
      allow update: if adminMi() || (moduluDuzenleyebilir('sinavIslemleri')
        && (('sahipUid' in resource.data && resource.data.sahipUid == request.auth.uid)
          || !('sahipUid' in resource.data))
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['sahipUid']));
      allow delete: if adminMi() || (moduluDuzenleyebilir('sinavIslemleri')
        && (('sahipUid' in resource.data && resource.data.sahipUid == request.auth.uid)
          || !('sahipUid' in resource.data)));
    }

    match /oy_denemeSinavlari/{id} {
      allow read: if girisYapmis();
      allow create: if adminMi() || (moduluDuzenleyebilir('sinavIslemleri')
        && request.resource.data.sahipUid == request.auth.uid);
      allow update: if adminMi() || (moduluDuzenleyebilir('sinavIslemleri')
        && (('sahipUid' in resource.data && resource.data.sahipUid == request.auth.uid)
          || !('sahipUid' in resource.data))
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['sahipUid'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['sayacDurumu'])
          || ('sahipUid' in resource.data && resource.data.sahipUid == request.auth.uid)));
      allow delete: if adminMi() || (moduluDuzenleyebilir('sinavIslemleri')
        && (('sahipUid' in resource.data && resource.data.sahipUid == request.auth.uid)
          || !('sahipUid' in resource.data)));
    }

    match /oy_sosyalKulupler/{id} {
      allow read: if girisYapmis();
      allow create, update, delete: if moduluDuzenleyebilir('sosyalKulupler');
    }

    match /oy_belirliGunler/{id} {
      allow read: if girisYapmis();
      allow create, update, delete: if moduluDuzenleyebilir('belirliGunler');
    }

    match /oy_zumre/{id} {
      allow read: if girisYapmis();
      allow create, update, delete: if moduluDuzenleyebilir('zumre');
    }

    match /oy_sok/{id} {
      allow read: if girisYapmis();
      allow create, update, delete: if moduluDuzenleyebilir('sok');
    }

    match /oy_bepPlani/{id} {
      allow read: if girisYapmis();
      allow create, update, delete: if moduluDuzenleyebilir('bepPlani');
    }

    match /oy_rehberlik/{id} {
      allow read: if girisYapmis();
      allow create, update, delete: if moduluDuzenleyebilir('rehberlik');
    }

    match /oy_maarifRapor/{id} {
      allow read: if girisYapmis();
      allow create, update, delete: if moduluDuzenleyebilir('maarifRapor');
    }

    match /oy_digerEvrak/{id} {
      allow read: if girisYapmis();
      allow create, update, delete: if moduluDuzenleyebilir('digerEvrak');
    }

    match /oy_evrakTakibi/{id} {
      allow read: if girisYapmis();
      allow create, update, delete: if moduluDuzenleyebilir('evrak');
    }

    match /oy_dersProgrami/{id} {
      allow read: if girisYapmis();
      allow create, update, delete: if moduluDuzenleyebilir('dersProgrami') || moduluDuzenleyebilir('veri');
    }

    match /oy_notlar/{id} {
      allow read: if adminMi() || (girisYapmis() && resource.data.sahipUid == request.auth.uid);
      allow create: if adminMi() || (girisYapmis() && request.resource.data.sahipUid == request.auth.uid);
      allow update: if adminMi() || (girisYapmis() && resource.data.sahipUid == request.auth.uid && request.resource.data.sahipUid == request.auth.uid);
      allow delete: if adminMi() || (girisYapmis() && resource.data.sahipUid == request.auth.uid);
    }

    match /oy_hatirlaticilar/{id} {
      allow read: if adminMi() || (girisYapmis() && resource.data.sahipUid == request.auth.uid);
      allow create: if adminMi() || (girisYapmis() && request.resource.data.sahipUid == request.auth.uid);
      allow update: if adminMi() || (girisYapmis() && resource.data.sahipUid == request.auth.uid && request.resource.data.sahipUid == request.auth.uid);
      allow delete: if adminMi() || (girisYapmis() && resource.data.sahipUid == request.auth.uid);
    }

    match /oy_gorevler/{id} {
      allow read: if adminMi() || (girisYapmis() && resource.data.sahipUid == request.auth.uid);
      allow create: if adminMi() || (girisYapmis() && request.resource.data.sahipUid == request.auth.uid);
      allow update: if adminMi() || (girisYapmis() && resource.data.sahipUid == request.auth.uid && request.resource.data.sahipUid == request.auth.uid);
      allow delete: if adminMi() || (girisYapmis() && resource.data.sahipUid == request.auth.uid);
    }

    match /oy_konusmalar/{id} {
      allow read: if adminMi() || (girisYapmis() && request.auth.uid in resource.data.katilimciUidler);
      allow create: if adminMi() || (girisYapmis() && request.auth.uid in request.resource.data.katilimciUidler);
      allow update: if adminMi() || (girisYapmis() && request.auth.uid in resource.data.katilimciUidler && request.resource.data.katilimciUidler == resource.data.katilimciUidler);
      allow delete: if adminMi() || (girisYapmis() && request.auth.uid in resource.data.katilimciUidler);
    }

    match /oy_mesajlar/{id} {
      allow read: if adminMi() || konusmaKatilimcisiMi(resource.data.konusmaId);
      allow create: if adminMi() || (girisYapmis() && request.resource.data.gonderenUid == request.auth.uid && konusmaKatilimcisiMi(request.resource.data.konusmaId));
      allow update: if false;
      allow delete: if adminMi() || konusmaKatilimcisiMi(resource.data.konusmaId);
    }

    match /oy_dokumanlar/{id} {
      allow read: if adminMi() || (girisYapmis() && (resource.data.gorunurluk == 'herkes' || resource.data.olusturanUid == request.auth.uid));
      allow create: if adminMi() || (girisYapmis() && request.resource.data.olusturanUid == request.auth.uid && request.resource.data.gorunurluk == 'kisisel');
      allow update: if adminMi();
      allow delete: if adminMi() || (girisYapmis() && resource.data.olusturanUid == request.auth.uid);
    }

    match /oy_duyurular/{id} {
      allow read: if girisYapmis();
      allow create, delete: if moduluDuzenleyebilir('duyurular');
      allow update: if moduluDuzenleyebilir('duyurular') || (girisYapmis()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['okuyanlar'])
        && request.auth.uid in request.resource.data.okuyanlar
        && (!('okuyanlar' in resource.data)
          || request.resource.data.okuyanlar.diff(resource.data.okuyanlar).affectedKeys().hasOnly([request.auth.uid])));
    }

    match /oy_haberler/{id} {
      allow read: if girisYapmis();
      allow create, update, delete: if moduluDuzenleyebilir('haberler');
    }

    match /oy_haberKaynaklari/{id} {
      allow read: if girisYapmis();
      allow create, update, delete: if moduluDuzenleyebilir('haberler');
    }

    match /oy_okulBilgileri/{id} {
      allow read: if girisYapmis();
      allow create, update, delete: if moduluDuzenleyebilir('okulBilgileri');
    }

    match /oy_dersSaatleri/{id} {
      allow read: if girisYapmis();
      allow create, update, delete: if moduluDuzenleyebilir('sistemAyarlari');
    }

    match /oy_dersListesi/{id} {
      allow read: if girisYapmis();
      allow create, update, delete: if moduluDuzenleyebilir('sistemAyarlari');
    }

    match /oy_bransListesi/{id} {
      allow read: if girisYapmis();
      allow create, update, delete: if moduluDuzenleyebilir('sistemAyarlari');
    }

    match /oy_depolamaAyarlari/{id} {
      allow read: if girisYapmis();
      allow create, update, delete: if adminMi();
    }

    match /oy_hatirlatmaAyarlari/{id} {
      allow read: if girisYapmis();
      allow create, update, delete: if adminMi();
    }

    match /oy_ozelMenu/{id} {
      allow read: if girisYapmis();
      allow create, update, delete: if moduluDuzenleyebilir('ozelMenu');
    }

    match /oy_anketler/{id} {
      allow read: if moduluGorebilir('anket');
      allow create, delete: if adminMi();
      allow update: if adminMi() || (moduluGorebilir('anket')
        && resource.data.aktif == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['oylar'])
        && request.auth.uid in request.resource.data.oylar
        && request.resource.data.oylar.diff(resource.data.oylar).affectedKeys().hasOnly([request.auth.uid]));
    }

    match /oy_odevTakip/{id} {
      allow read: if adminMi() || (girisYapmis() && resource.data.sahipUid == request.auth.uid);
      allow create: if adminMi() || (girisYapmis() && request.resource.data.sahipUid == request.auth.uid);
      allow update: if adminMi() || (girisYapmis() && resource.data.sahipUid == request.auth.uid && request.resource.data.sahipUid == request.auth.uid);
      allow delete: if adminMi() || (girisYapmis() && resource.data.sahipUid == request.auth.uid);
    }

    match /oy_notCizelgesi/{id} {
      allow read: if adminMi() || (girisYapmis() && resource.data.sahipUid == request.auth.uid);
      allow create: if adminMi() || (girisYapmis() && request.resource.data.sahipUid == request.auth.uid);
      allow update: if adminMi() || (girisYapmis() && resource.data.sahipUid == request.auth.uid && request.resource.data.sahipUid == request.auth.uid);
      allow delete: if adminMi() || (girisYapmis() && resource.data.sahipUid == request.auth.uid);
    }

    match /oy_yillikPlanBasliklari/{id} {
      allow read: if girisYapmis();
      allow write: if adminMi();
    }

    match /oy_yillikPlanTanimlari/{id} {
      allow read: if girisYapmis();
      allow create, delete: if adminMi();
      allow update: if adminMi() || (girisYapmis() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sutunGenislikleri', 'fontBoyutuPx', 'imzaTarihi', 'satirlar', 'okulAdiManuel']));
    }

    match /oy_ogretmenYillikPlanSecimleri/{ogretmenId} {
      allow read: if girisYapmis();
      allow create, update: if girisYapmis() && kendiOgretmenIdsi() == ogretmenId;
      allow delete: if false;
    }

    match /oy_yillikPlanNotlari/{docId} {
      allow read: if girisYapmis();
      allow create, update: if girisYapmis() && kendiOgretmenIdsi() == docId.split('_')[0];
      allow delete: if false;
    }

    match /oy_akademikTakvim/{id} {
      allow read: if girisYapmis();
      allow write: if adminMi();
    }

    match /oy_kontrolListeleri/{id} {
      allow read: if girisYapmis();
      allow write: if adminMi();
    }

    match /oy_kontrolListeTamamlama/{docId} {
      allow read: if girisYapmis();
      allow create, update: if girisYapmis() && kendiOgretmenIdsi() == docId.split('_')[0];
      allow delete: if false;
    }

    match /oy_denemeSonuclari/{id} {
      allow read: if girisYapmis();
      allow create, update, delete: if moduluGorebilir('denemeSonuclari');
    }

    match /oy_testSonuclari/{id} {
      allow read: if girisYapmis();
      allow create, update, delete: if moduluGorebilir('testSonuclari');
    }
  }
}
